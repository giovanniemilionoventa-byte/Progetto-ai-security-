# Secrets. The compose stack refuses to start without these and the app
# refuses to start on the shipped defaults. Generate with scripts/init-env.sh.
AEGIS_SECRET_KEY=change-me-in-production
AEGIS_EAT_KEY=change-me-eat-key
# HMAC key for the tamper-evident execution evidence chain. Before Phase 17
# this variable appeared nowhere, so every deployment used the constant in
# config.py and anyone able to write the database could recompute the chain.
AEGIS_EVIDENCE_SECRET_KEY=change-me-evidence-key
AEGIS_DATABASE_URL=sqlite:///./aegis.db
AEGIS_CORS_ORIGINS=http://localhost:5173
AEGIS_TOKEN_TTL_MINUTES=720
AEGIS_ROLE=all
AEGIS_INTERNAL_GATEWAY_TOKEN=change-me-gateway-internal-token
AEGIS_INTERNAL_TOOL_TOKEN=change-me-tool-internal-token
# Master credential. Per-tenant tool credentials are derived from this;
# it is never used to call the tool directly and never reaches an agent.
AEGIS_CRM_SECRET=your-crm-secret-here
AEGIS_BROKER_URL=
AEGIS_TOOL_URL=
AEGIS_EAT_TTL_SECONDS=10
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# Enforcement posture
AEGIS_REQUIRE_RUNTIME_CONTRACT=true
AEGIS_APPROVAL_TTL_SECONDS=900
AEGIS_REMOTE_TIMEOUT_SECONDS=3
# Set to 1 only for local development; the app otherwise refuses to start on
# the shipped default secrets.
AEGIS_ALLOW_DEFAULT_SECRETS=0
